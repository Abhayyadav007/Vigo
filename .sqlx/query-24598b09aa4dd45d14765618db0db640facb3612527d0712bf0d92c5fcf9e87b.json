  "query": "\n        INSERT INTO users (firebase_uid, phone)\n        VALUES ($1, $2)\n        ON CONFLICT (firebase_uid) DO UPDATE\n            SET phone = EXCLUDED.phone\n        RETURNING id, firebase_uid, phone, name, role AS \"role: Role\", store_id,\n                  is_active, created_at, updated_at\n        ",
