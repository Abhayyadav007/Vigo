{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, firebase_uid, phone, name, role AS \"role: Role\", store_id,\n               is_active, created_at, updated_at,\n               count(*) OVER () AS \"total!\"\n        FROM users\n        WHERE ($1::text IS NULL OR phone LIKE $1)\n          AND ($2::user_role IS NULL OR role = $2)\n        ORDER BY created_at DESC, id\n        LIMIT $3 OFFSET $4\n        ",
