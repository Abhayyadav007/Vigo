  "query": "\n        SELECT c.id, c.parent_id, c.name, c.slug, c.image_url, c.sort_order, c.is_active,\n               (SELECT count(*) FROM products p WHERE p.category_id = c.id) AS \"product_count!\"\n        FROM categories c\n        ORDER BY c.sort_order, c.name\n        ",
