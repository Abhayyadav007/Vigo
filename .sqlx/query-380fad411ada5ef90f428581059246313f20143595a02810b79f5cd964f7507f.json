{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.name, u.phone, coalesce(p.vehicle_type, 'SCOOTER') AS \"vehicle_type!: VehicleType\",\n               p.vehicle_number\n        FROM users u LEFT JOIN rider_profiles p ON p.user_id = u.id\n        WHERE u.id = $1\n        ",
