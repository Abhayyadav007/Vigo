{
  "name": "vigo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typegen": "turbo run typegen",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "emulators": "pnpm dlx firebase-tools@15 emulators:start --only auth --project demo-vigo",
    "e2e:auth": "node scripts/e2e-auth.mjs",
    "e2e:orders": "node scripts/e2e-orders.mjs",
    "e2e:picker": "node scripts/e2e-picker.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.4",
    "typescript": "catalog:",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1",
    "jiti": "^2.6.1"
  }
}
