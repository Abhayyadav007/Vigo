# Copy to .env and adjust. .env is gitignored — never commit real credentials.

POSTGRES_USER=vigo
POSTGRES_PASSWORD=vigo_dev_password
POSTGRES_DB=vigo
POSTGRES_PORT=5432

# Consumed by sqlx (CLI + compile-time query macros) and the axum app
DATABASE_URL=postgres://vigo:vigo_dev_password@localhost:5432/vigo
