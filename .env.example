# Copy to .env at the repo root, then adjust. The backend finds it from any subdirectory.

# --- backend ---
# development | production (production = JSON logs)
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://vigo:vigo@localhost:5432/vigo
DB_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:6379
# Firebase project id. `demo-vigo` works offline with the Auth emulator
# (`pnpm emulators`); use your real project id otherwise.
FIREBASE_PROJECT_ID=demo-vigo
# Dev only: accept unsigned tokens from the Firebase Auth emulator. The backend
# refuses to start with this set when APP_ENV=production. Comment out to use
# real Firebase.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# comma-separated; empty = allow any
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECS=15
# Seconds a firebase_uid -> role lookup stays cached in Redis.
SESSION_CACHE_TTL_SECS=300
RUST_LOG=info,backend=debug,tower_http=info,sqlx=warn
# Uploaded product images (relative paths resolve next to this .env file).
MEDIA_DIR=media
# Seconds checkout holds stock for an unpaid (online) order before releasing it.
RESERVATION_TTL_SECS=600
# Razorpay (online payments). Leave empty for COD-only. The gateway call is
# stubbed for now; webhook signatures are verified with the secret.
RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
# Rider dispatch: offer radius around the store, seconds to accept, riders
# offered at once (first accept wins), and how old a GPS fix may be.
DISPATCH_RADIUS_M=5000
DISPATCH_OFFER_TTL_SECS=30
DISPATCH_WAVE_SIZE=3
RIDER_STALE_SECS=60

# --- clients ---
# Expo apps read EXPO_PUBLIC_*; web-admin reads VITE_*.
# On a physical device use your machine's LAN IP instead of localhost
# (Android emulator: http://10.0.2.2:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# Firebase web config for web-admin (Firebase console -> Project settings).
# Any non-empty API key works against the emulator.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=demo-vigo
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=

# Expo apps: point RN Firebase at the emulator (Android emulator: 10.0.2.2:9099).
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Customer app: skip GPS and pretend to be here (lat,lng). This is inside the
# demo Indiranagar store from `backend seed-demo`. Remove to use real GPS.
EXPO_PUBLIC_DEV_LOCATION=12.9784,77.6408
