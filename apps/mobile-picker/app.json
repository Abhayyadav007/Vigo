{
  "expo": {
    "name": "Vigo Picker",
    "slug": "vigo-picker",
    "scheme": "vigo-picker",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vigo.picker",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vigo.picker"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Vigo Picker uses the camera to scan product barcodes while packing orders.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ]
    ]
  }
}
